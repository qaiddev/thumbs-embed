{
  "name": "@qaiddev/thumbs-embed",
  "version": "1.0.0",
  "description": "Standalone feedback embed with element targeting",
  "type": "module",
  "main": "./dist/qaid.umd.cjs",
  "module": "./dist/qaid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/qaid.js",
      "require": "./dist/qaid.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qaiddev/thumbs-embed.git"
  },
  "homepage": "https://github.com/qaiddev/thumbs-embed#readme",
  "bugs": {
    "url": "https://github.com/qaiddev/thumbs-embed/issues"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-dts": "^3.7.1",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "feedback",
    "embed",
    "element-targeting",
    "qaid"
  ],
  "license": "MIT"
}
