{
  "name": "@qaiddev/thumbs-embed",
  "version": "1.6.1",
  "description": "Precision User Feedback",
  "type": "module",
  "main": "./dist/qaid.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/qaid.umd.cjs"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./embed": {
      "default": "./dist/embed.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qaiddev/thumbs-embed.git"
  },
  "homepage": "https://github.com/qaiddev/thumbs-embed#readme",
  "bugs": {
    "url": "https://github.com/qaiddev/thumbs-embed/issues"
  },
  "scripts": {
    "dev": "vite build --watch --config vite.config.esm.ts",
    "build": "vite build && vite build --config vite.config.esm.ts && vite build --config vite.config.index.ts && vite build --config vite.config.embed.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage && npm run coverage:badge",
    "coverage:badge": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/coverage-badge.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "axe-core": "^4.12.1",
    "happy-dom": "^20.5.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "feedback",
    "embed",
    "element-targeting",
    "qaid"
  ],
  "license": "MIT"
}
